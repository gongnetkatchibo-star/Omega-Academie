FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# Base de données. Laisser vide en développement = SQLite local
# (instance/app.db). En production, renseigner l'URL PostgreSQL fournie
# par l'hébergeur, ex :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

# Envoi d'email (mot de passe oublié). Laisser vide pour désactiver :
# le lien de réinitialisation s'affichera alors directement à l'écran.
# Exemple avec un compte Gmail (utiliser un « mot de passe d'application »,
# pas le mot de passe normal du compte : myaccount.google.com/apppasswords) :
# Envoi d'email — via l'API Brevo (HTTPS), pas du SMTP classique :
# Render bloque les ports SMTP (25/465/587) sur son plan gratuit
# (sept. 2026). Crée un compte gratuit sur brevo.com, récupère une clé
# API (SMTP & API > Clés API), et renseigne-la ici.
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_DEFAULT_SENDER_NOM=Omega Académie

# Assistant IA (optionnel). Laisser vide = mode sans IA générative,
# fonctionne déjà sans coût. Renseigner pour activer un vrai modèle.
ANTHROPIC_API_KEY=
