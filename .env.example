FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# Base de données. Laisser vide en développement = SQLite local
# (instance/app.db). En production, renseigner l'URL PostgreSQL fournie
# par l'hébergeur, ex :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

# Envoi d'email (codes, mot de passe oublié, avis aux parents), par
# l'API de brevo.com (SMTP & API > Clés API). Sans clé, aucun email ne
# part ; en développement seulement, codes et liens s'affichent alors à
# l'écran (jamais en production).
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_DEFAULT_SENDER_NOM="Omega Académie"

# Code par email à chaque connexion du compte développeur : mettre 1 une
# fois l'envoi d'emails vérifié. (Pour la direction des écoles, l'option
# se règle dans « Établissement ».)
DOUBLE_AUTH_DEVELOPPEUR=0

# Ce fichier sert au poste de développement. Pour le serveur en ligne,
# le modèle est deploiement/env.production.exemple (HTTPS_ACTIF,
# HOTES_AUTORISES, CLE_INSTALLATION, PROXY_COUCHES=1…), rempli tout seul
# par deploiement/installer.sh.
PROXY_COUCHES=0

# Facultatif : rejouer les tests sur PostgreSQL (base vide, réservée aux
# tests — elle est effacée à chaque test).
# TEST_DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1/toumai_test

# Assistant IA (optionnel). Laisser vide = mode sans IA générative,
# fonctionne déjà sans coût. Renseigner pour activer un vrai modèle.
ANTHROPIC_API_KEY=
