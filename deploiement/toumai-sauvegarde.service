# Sauvegarde nocturne (lancée par toumai-sauvegarde.timer) :
# 1. copie complète de la base — celle qui sert après une panne du serveur ;
# 2. une archive par école, restaurable depuis la console « Plateforme ».
[Unit]
Description=Sauvegarde Toumaï Edu School
After=postgresql.service

[Service]
Type=oneshot
User=toumai
Group=toumai
WorkingDirectory=/opt/toumai_edu_school
EnvironmentFile=/opt/toumai_edu_school/.env
ExecStart=/opt/toumai_edu_school/venv/bin/flask --app run.py sauvegarder-base --dossier /var/sauvegardes/toumai --garder 14
ExecStart=/opt/toumai_edu_school/venv/bin/flask --app run.py sauvegarder-ecoles --dossier /var/sauvegardes/toumai --garder 7
