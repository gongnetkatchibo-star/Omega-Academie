# Réglages du serveur en ligne — à copier en .env à la racine du dossier
# de l'application (deploiement/installer.sh le fait tout seul).
# Ce fichier contient des secrets : jamais dans Git, lisible par le seul
# compte du serveur (chmod 600).

FLASK_APP=run.py
FLASK_ENV=production

# Clé qui signe les sessions. Une longue valeur tirée au hasard :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base PostgreSQL du serveur.
DATABASE_URL=postgresql://toumai:MOT_DE_PASSE@127.0.0.1:5432/toumai

# 1 = l'application est derrière nginx (toujours, sur le serveur).
PROXY_COUCHES=1

# 1 dès que le site répond en https. 0 seulement le temps d'essayer le
# serveur par son adresse IP, avant le nom de domaine et son certificat.
HTTPS_ACTIF=1

# Nom(s) de domaine du site, séparés par des virgules. Toute requête
# adressée à un autre nom est refusée.
HOTES_AUTORISES=

# Pour créer le premier compte depuis le navigateur
# (https://…/auth/premiere-configuration). Sinon, sur le serveur :
#   flask creer-compte-initial
CLE_INSTALLATION=

# Envoi des emails (codes, mot de passe oublié, avis aux parents) :
# clé API de brevo.com et adresse d'expéditeur validée chez Brevo.
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
MAIL_DEFAULT_SENDER_NOM="Omega Académie"

# Code par email à chaque connexion du super-administrateur : mettre 1
# une fois l'envoi d'emails vérifié.
DOUBLE_AUTH_DEVELOPPEUR=0

# Heure de l'école (reçus, absences, année scolaire).
FUSEAU_HORAIRE=Africa/Ndjamena

# Facultatif : suivi des erreurs (sentry.io).
SENTRY_DSN=
